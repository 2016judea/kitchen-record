{"buildCommand":"echo build","outputDirectory":"public",
 "functions":{"api/data.js":{"includeFiles":"api/_full/**","memory":1024},"api/checkout.js":{"includeFiles":"public/meta.json"}},
 "rewrites":[{"source":"/for/:token","destination":"/index.html"},{"source":"/for/:token/","destination":"/index.html"}],
 "headers":[{"source":"/(meta|for).json","headers":[{"key":"Cache-Control","value":"public, max-age=0, must-revalidate"}]},
            {"source":"/data/(.*)","headers":[{"key":"Cache-Control","value":"public, max-age=0, must-revalidate"}]}],
 "redirects":[{"source":"/api/_full/:path*","destination":"/","permanent":false},{"source":"/api/%5Ffull/:path*","destination":"/","permanent":false},{"source":"/api/%5ffull/:path*","destination":"/","permanent":false}]}
